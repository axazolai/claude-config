# .claude/* rather than .claude/, because git cannot re-include a file whose parent directory
# is excluded. The hand-written project CLAUDE.md is tracked; the compiled stack-rules.md
# snapshot, settings.local.json and everything else under it stay local.
.claude/*
!.claude/CLAUDE.md
.vscode/
node_modules/
.env
.env.*
*.pem
*.key
*.pfx
*.p12
**/__pycache__/
.reference/
.test/
.planning/
/.idea/

# Draft letter to service owners: internal addresses, never commit
/docs/deepseek-letter-to-owners.md

# phase 29 reference project (a copy of an external project; never committed)
.ultrapowers/phases/29-logic-map/ref-project/
