{
  "_comment": "Reference only. Prefer `node setup.mjs` (merges these keys into your existing ~/.claude/settings.json and fills absolute paths). Manual merge: ADD these keys, keep your model/enabledPlugins/language. Replace <HOME> with your real home dir (Linux/macOS: /home/you ; Windows JSON: C:\\\\Users\\\\you).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/deny-curated-claude-md.mjs"] }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/protected-guard.mjs"] }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/secrets-gate.mjs"] }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/decision-records-nudge.mjs"] }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/worktree-executor-discipline-advisor.mjs"] }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/bg-supervision-nudge.mjs"] }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/deepseek-offload-nudge.mjs"] }
        ]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/schedulewakeup-loop-only-nudge.mjs"] }
        ]
      },
      {
        "matcher": "^mcp__scrapling__.*",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/scrapling-raw-gate.mjs"] }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/scratchpad-layout-guard.mjs"] }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/background-sleep-guard.mjs"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/ci-watch-nudge.mjs"] }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/prune-tests-nudge.mjs"] }
        ]
      },
      {
        "matcher": "WebFetch|mcp__plugin_context-mode_context-mode__ctx_fetch_and_index",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/web-block-nudge.mjs"] }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/phase-end-cleanup-nudge.mjs"] }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "WebFetch|mcp__plugin_context-mode_context-mode__ctx_fetch_and_index",
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/web-block-nudge.mjs"] }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/rung-usage-log.mjs"] }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/precompact-observe.mjs"] }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/session-init.mjs"] },
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/inject-axes.mjs"] },
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/scratchpad-temp-env.mjs"] },
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/cisco-proxy-advisor.mjs"] }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["<HOME>/.claude/hooks/inject-axes.mjs"] }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Edit(~/.claude/CLAUDE.md)"]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"<HOME>/.claude/hooks/statusline.mjs\"",
    "refreshInterval": 2
  }
}
